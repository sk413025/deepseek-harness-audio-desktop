+++ b/apps/desktop/src/distribution-settings.ts
@@ -0,0 +1,186 @@
+/**
+ * LOCAL PATCH (sbplab): distribution default settings.
+ *
+ * A local build may ship `Resources/distribution-settings.yaml`, a block-style YAML document whose top-level keys are
+ * settings namespaces (for example the audio model library's DGX server). Before the host starts, each of those
+ * namespaces that the user's `settings.yaml` does not contain, and that this profile never seeded before, is appended
+ * to that document as text, so the user's own comments and formatting stay untouched. User values are never
+ * overwritten, and a namespace the user deletes later is not seeded again (the record lives in the profile root).
+ * A `...File:` line whose absolute or `~/` path does not exist on this computer is left out, so a plugin reports that
+ * setting as not configured instead of failing on a missing file.
+ */
+
+import { createHash, randomBytes } from 'node:crypto'
+import { existsSync } from 'node:fs'
+import { mkdir, open, readFile, rename, rm, writeFile } from 'node:fs/promises'
+import { homedir } from 'node:os'
+import { dirname, isAbsolute, join } from 'node:path'
+
+export interface DistributionSettingsOptions {
+  /** Distribution document shipped with the app; absent file = nothing to do. */
+  readonly source: string
+  /** The user's settings document (`$DSH_HOME/settings.yaml`). */
+  readonly settings: string
+  /** Seed record (`<profile root>/distribution-settings.json`). */
+  readonly state: string
+  readonly releaseTag?: string | undefined
+  readonly now?: () => Date
+  readonly lockWaitMs?: number
+}
+
+export interface DistributionSettingsResult {
+  readonly applied: readonly string[]
+  readonly skipped: ReadonlyArray<{ readonly namespace: string, readonly reason: 'present' | 'seeded-before' }>
+  readonly droppedMissingFiles: readonly string[]
+  readonly refused?: string | undefined
+}
+
+interface SeedState {
+  readonly schemaVersion: 1
+  seeded: Record<string, { at: string, releaseTag?: string, sha256: string }>
+}
+
+const TOP_KEY = /^([A-Za-z0-9_][A-Za-z0-9_.-]*)\s*:(?:\s|$)/u
+const FILE_LINE = /^(\s*)([A-Za-z0-9_]*File)\s*:\s*(['"]?)([^'"#\n]+?)\3\s*(?:#.*)?$/u
+
+/** Top-level keys of a block-style YAML document; `undefined` for flow/JSON documents, which are left alone. */
+export function topLevelKeys(text: string): Set<string> | undefined {
+  const lines = text.replace(/^﻿/u, '').split(/\r?\n/u)
+  const first = lines.find(line => line.trim() !== '' && !line.trimStart().startsWith('#') && line.trim() !== '---')
+  if (first !== undefined && /^\s*[{[]/u.test(first)) return undefined
+  const keys = new Set<string>()
+  for (const line of lines) {
+    const match = TOP_KEY.exec(line)
+    if (match) keys.add(match[1]!)
+  }
+  return keys
+}
+
+/** Split a block-style distribution document into its top-level namespace blocks (leading comments stay attached). */
+export function namespaceBlocks(text: string): Array<{ namespace: string, block: string }> {
+  const blocks: Array<{ namespace: string, lines: string[] }> = []
+  let pending: string[] = []
+  for (const line of text.replace(/^﻿/u, '').split(/\r?\n/u)) {
+    if (line.trim() === '---') continue
+    const match = TOP_KEY.exec(line)
+    if (match) {
+      blocks.push({ namespace: match[1]!, lines: [...pending, line] })
+      pending = []
+    } else if (blocks.length === 0 || line.trimStart().startsWith('#') || line.trim() === '') {
+      // Comments and blank lines belong to whatever follows them: the next namespace or more of the current one.
+      pending.push(line)
+    } else {
+      const last = blocks.at(-1)!
+      last.lines.push(...pending, line)
+      pending = []
+    }
+  }
+  return blocks.map(({ namespace, lines }) => {
+    while (lines.length > 0 && lines.at(-1)!.trim() === '') lines.pop()
+    return { namespace, block: `${lines.join('\n')}\n` }
+  })
+}
+
+function expandHome(path: string): string {
+  return path === '~' || path.startsWith('~/') ? join(homedir(), path.slice(2)) : path
+}
+
+/** Drop `...File:` lines whose path is missing on this computer. */
+export function dropMissingFiles(block: string, exists: (path: string) => boolean = existsSync): { block: string, dropped: string[] } {
+  const dropped: string[] = []
+  const lines = block.split('\n').filter((line) => {
+    const match = FILE_LINE.exec(line)
+    if (!match) return true
+    const value = match[4]!.trim()
+    const path = expandHome(value)
+    if (!isAbsolute(path) || exists(path)) return true
+    dropped.push(`${match[2]}: ${value}`)
+    return false
+  })
+  return { block: lines.join('\n'), dropped }
+}
+
+async function withLock<T>(filename: string, waitMs: number, operation: () => Promise<T>): Promise<T> {
+  // Same protocol as @deepseek-ai/dsh-atomic-write withFileLock: a `wx`-created `<file>.lock` sibling.
+  const lock = `${filename}.lock`
+  const deadline = Date.now() + waitMs
+  let delay = 10
+  for (;;) {
+    try {
+      const handle = await open(lock, 'wx')
+      await handle.close()
+      break
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error
+      if (Date.now() >= deadline) throw new Error(`distribution settings: ${lock} is held by another writer`)
+      await new Promise(resolve => setTimeout(resolve, delay))
+      delay = Math.min(delay * 2, 200)
+    }
+  }
+  try {
+    return await operation()
+  } finally {
+    await rm(lock, { force: true })
+  }
+}
+
+async function writeAtomic(filename: string, text: string, mode: number): Promise<void> {
+  const temp = `${filename}.${randomBytes(6).toString('hex')}.tmp`
+  await writeFile(temp, text, { mode, flag: 'wx' })
+  await rename(temp, filename)
+}
+
+async function readText(filename: string): Promise<string | undefined> {
+  try {
+    return await readFile(filename, 'utf8')
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return undefined
+    throw error
+  }
+}
+
+/** Seed missing distribution namespaces into the user's settings document. */
+export async function seedDistributionSettings(options: DistributionSettingsOptions): Promise<DistributionSettingsResult> {
+  const source = await readText(options.source)
+  if (source === undefined) return { applied: [], skipped: [], droppedMissingFiles: [] }
+  if (topLevelKeys(source) === undefined) return { applied: [], skipped: [], droppedMissingFiles: [], refused: 'distribution document is not block-style YAML' }
+  const blocks = namespaceBlocks(source)
+  const now = (options.now ?? (() => new Date()))().toISOString()
+  await mkdir(dirname(options.settings), { recursive: true, mode: 0o700 })
+  return withLock(options.settings, options.lockWaitMs ?? 2000, async () => {
+    const current = await readText(options.settings)
+    const keys = current === undefined ? new Set<string>() : topLevelKeys(current)
+    if (keys === undefined) return { applied: [], skipped: [], droppedMissingFiles: [], refused: 'settings document is not block-style YAML; left unchanged' }
+    const stateText = await readText(options.state)
+    let state: SeedState = { schemaVersion: 1, seeded: {} }
+    if (stateText !== undefined) {
+      try {
+        const parsed = JSON.parse(stateText) as Partial<SeedState>
+        if (parsed && typeof parsed.seeded === 'object' && parsed.seeded !== null) state = { schemaVersion: 1, seeded: { ...parsed.seeded } }
+      } catch {
+        // A damaged record seeds nothing new rather than risk re-adding namespaces the user removed.
+        return { applied: [], skipped: [], droppedMissingFiles: [], refused: `seed record ${options.state} is unreadable` }
+      }
+    }
+    const applied: string[] = []
+    const skipped: Array<{ namespace: string, reason: 'present' | 'seeded-before' }> = []
+    const droppedMissingFiles: string[] = []
+    let append = ''
+    for (const { namespace, block } of blocks) {
+      if (keys.has(namespace)) { skipped.push({ namespace, reason: 'present' }); continue }
+      if (state.seeded[namespace] !== undefined) { skipped.push({ namespace, reason: 'seeded-before' }); continue }
+      const kept = dropMissingFiles(block)
+      droppedMissingFiles.push(...kept.dropped.map(line => `${namespace}.${line}`))
+      append += kept.block
+      applied.push(namespace)
+      state.seeded[namespace] = { at: now, ...(options.releaseTag ? { releaseTag: options.releaseTag } : {}), sha256: createHash('sha256').update(block).digest('hex') }
+    }
+    if (applied.length === 0) return { applied, skipped, droppedMissingFiles }
+    const header = `# Added by DeepSeek Harness Audio${options.releaseTag ? ` ${options.releaseTag}` : ''} distribution defaults (${now}); edit freely, it is not added again.\n`
+    const base = current === undefined || current.trim() === '' ? '' : current.endsWith('\n') ? `${current}\n` : `${current}\n\n`
+    await writeAtomic(options.settings, `${base}${header}${append}`, 0o600)
+    await mkdir(dirname(options.state), { recursive: true })
+    await writeAtomic(options.state, `${JSON.stringify(state, null, 2)}\n`, 0o600)
+    return { applied, skipped, droppedMissingFiles }
+  })
+}
