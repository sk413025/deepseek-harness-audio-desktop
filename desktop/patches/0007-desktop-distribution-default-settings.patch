diff --git a/apps/desktop/tests/distribution-settings.spec.ts b/apps/desktop/tests/distribution-settings.spec.ts
new file mode 100644
index 0000000..ca958f6
--- /dev/null
+++ b/apps/desktop/tests/distribution-settings.spec.ts
@@ -0,0 +1,87 @@
+import { mkdir, mkdtemp, readFile, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { afterEach, beforeEach, describe, expect, it } from 'vitest'
+import { dropMissingFiles, namespaceBlocks, seedDistributionSettings, topLevelKeys } from '../src/distribution-settings.ts'
+
+const DISTRIBUTION = `# library server
+dsh-audio-model-library:
+  servers:
+    - id: dgx-spark
+      modelHost: 100.83.70.119
+  referenceVoiceFile: /definitely/missing/voice.wav
+dsh-dgx-audio:
+  routes: []
+`
+
+describe('distribution settings seed', () => {
+  let dir: string
+  beforeEach(async () => { dir = await mkdtemp(join(tmpdir(), 'dsh-dist-settings-')) })
+  afterEach(async () => { await rm(dir, { recursive: true, force: true }) })
+
+  const options = () => ({ source: join(dir, 'distribution-settings.yaml'), settings: join(dir, 'home', 'settings.yaml'), state: join(dir, 'profile', 'distribution-settings.json'), releaseTag: 'audio.2-test', now: () => new Date('2026-09-15T10:00:00Z') })
+
+  it('reads top-level keys of block YAML and refuses flow documents', () => {
+    expect([...topLevelKeys('# c\nui-onboarding: { a: 1 }\nagent-default-model:\n  provider: x\n')!]).toEqual(['ui-onboarding', 'agent-default-model'])
+    expect(topLevelKeys('{ "a": 1 }')).toBeUndefined()
+    expect(namespaceBlocks(DISTRIBUTION).map(block => block.namespace)).toEqual(['dsh-audio-model-library', 'dsh-dgx-audio'])
+    expect(namespaceBlocks(DISTRIBUTION)[0]!.block.startsWith('# library server\n')).toBe(true)
+  })
+
+  it('drops file settings whose path is missing and keeps existing ones', () => {
+    const kept = dropMissingFiles('a:\n  voiceFile: /missing.wav\n  otherFile: /present.wav\n', path => path === '/present.wav')
+    expect(kept.block).toBe('a:\n  otherFile: /present.wav\n')
+    expect(kept.dropped).toEqual(['voiceFile: /missing.wav'])
+  })
+
+  it('appends only missing namespaces, keeps user text, and never re-seeds a removed namespace', async () => {
+    const o = options()
+    await writeFile(o.source, DISTRIBUTION)
+    const user = '# my comment\nagent-default-model: { provider: p, model: m }\ndsh-dgx-audio:\n  routes:\n    - provider: mine\n'
+    await mkdir(join(dir, 'home'))
+    await writeFile(o.settings, user)
+    const first = await seedDistributionSettings(o)
+    expect(first.applied).toEqual(['dsh-audio-model-library'])
+    expect(first.skipped).toEqual([{ namespace: 'dsh-dgx-audio', reason: 'present' }])
+    expect(first.droppedMissingFiles).toEqual(['dsh-audio-model-library.referenceVoiceFile: /definitely/missing/voice.wav'])
+    const after = await readFile(o.settings, 'utf8')
+    expect(after.startsWith(user)).toBe(true)
+    expect(after).toContain('modelHost: 100.83.70.119')
+    expect(after).not.toContain('referenceVoiceFile')
+    expect(after.match(/provider: mine/gu)).toHaveLength(1)
+
+    // Second launch: nothing new.
+    expect((await seedDistributionSettings(o)).applied).toEqual([])
+    // The user deletes the seeded section: it stays deleted.
+    await writeFile(o.settings, user)
+    const third = await seedDistributionSettings(o)
+    expect(third.applied).toEqual([])
+    expect(third.skipped).toContainEqual({ namespace: 'dsh-audio-model-library', reason: 'seeded-before' })
+    expect(await readFile(o.settings, 'utf8')).toBe(user)
+  })
+
+  it('creates the settings document on a fresh home and leaves flow documents alone', async () => {
+    const o = options()
+    await writeFile(o.source, DISTRIBUTION)
+    const fresh = await seedDistributionSettings(o)
+    expect(fresh.applied).toEqual(['dsh-audio-model-library', 'dsh-dgx-audio'])
+    expect(topLevelKeys(await readFile(o.settings, 'utf8'))).toEqual(new Set(['dsh-audio-model-library', 'dsh-dgx-audio']))
+
+    const flow = { ...o, settings: join(dir, 'flow.yaml'), state: join(dir, 'flow-state.json') }
+    await writeFile(flow.settings, '{ "ui-onboarding": {} }\n')
+    expect((await seedDistributionSettings(flow)).refused).toMatch(/not block-style/u)
+    expect(await readFile(flow.settings, 'utf8')).toBe('{ "ui-onboarding": {} }\n')
+  })
+
+  it('waits for and respects the settings writer lock', async () => {
+    const o = { ...options(), lockWaitMs: 50 }
+    await writeFile(o.source, DISTRIBUTION)
+    await mkdir(join(dir, 'home'))
+    await writeFile(`${o.settings}.lock`, '')
+    await expect(seedDistributionSettings(o)).rejects.toThrow(/held by another writer/u)
+  })
+
+  it('does nothing without a distribution document', async () => {
+    expect(await seedDistributionSettings(options())).toEqual({ applied: [], skipped: [], droppedMissingFiles: [] })
+  })
+})
