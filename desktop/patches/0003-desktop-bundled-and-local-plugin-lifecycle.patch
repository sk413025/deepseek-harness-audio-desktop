+  manifest.dsh.profile.bundles.push(...rows.map(row => row.name))
+  writeFileSync(manifestPath, `${JSON.stringify(manifest, undefined, 2)}\n`, { mode: 0o600 })
+  writeFileSync(join(SEED_ROOT, DESKTOP_BUNDLED_PLUGINS_FILE), `${JSON.stringify({ schemaVersion: 1, plugins: rows }, undefined, 2)}\n`, { mode: 0o600 })
