+        writeProfilePlugins(projectDir, next.map(name => inspectPlugin(projectDir, name)).sort(byName))
+        return { name: mutation.name, disableBundled: !mutation.enabled }
+      }
       default:
         mutation satisfies never
+        throw new Error('desktop project: unsupported mutation')
+    }
+  }
+
+  private readPluginState(): DesktopPluginState {
+    if (!existsSync(this.paths.pluginState)) return { schemaVersion: 1, disabledBundled: [], restoreFailures: [] }
+    const value = readJson(this.paths.pluginState)
+    if (!isRecord(value) || value.schemaVersion !== 1 || !Array.isArray(value.disabledBundled)
+      || !Array.isArray(value.restoreFailures)) {
+      throw new Error(`desktop project: invalid plugin state ${this.paths.pluginState}`)
+    }
+    return {
+      schemaVersion: 1,
+      disabledBundled: value.disabledBundled.filter((name): name is string => typeof name === 'string'),
+      restoreFailures: value.restoreFailures.flatMap((row): DesktopRestoreFailure[] => (
+        isRecord(row) && typeof row.name === 'string' && typeof row.version === 'string'
+          && (row.source === 'bundled' || row.source === 'local' || row.source === 'registry')
+          && typeof row.message === 'string'
+          ? [{ name: row.name, version: row.version, source: row.source, message: row.message }]
+          : []
+      )),
+    }
+  }
+
+  private writePluginState(state: DesktopPluginState): void {
+    mkdirSync(this.paths.root, { recursive: true, mode: 0o700 })
+    const temporary = `${this.paths.pluginState}.${String(process.pid)}.tmp`
+    writeJson(temporary, state)
+    renameSync(temporary, this.paths.pluginState)
+  }
+
+  private recordOutcome(outcome: DesktopMutationOutcome): void {
+    const state = this.readPluginState()
+    const disabled = new Set(state.disabledBundled)
+    if (outcome.disableBundled === true) disabled.add(outcome.name)
+    if (outcome.disableBundled === false) disabled.delete(outcome.name)
+    this.writePluginState({
+      schemaVersion: 1,
+      disabledBundled: [...disabled].sort(),
+      restoreFailures: state.restoreFailures.filter(failure => failure.name !== outcome.name),
+    })
+  }
+
+  /** Run pnpm, returning a diagnostic instead of throwing, and roll manifest files back on failure. */
+  private async tryPnpm(projectDir: string, args: readonly string[]): Promise<string | undefined> {
+    const snapshot = ['package.json', 'pnpm-lock.yaml'].map((file) => {
+      const path = join(projectDir, file)
+      return { path, body: existsSync(path) ? readFileSync(path) : undefined }
+    })
+    try {
+      await this.runPnpm(projectDir, args)
+      return undefined
+    } catch (error) {
+      for (const { path, body } of snapshot) {
+        if (body === undefined) rmSync(path, { force: true })
+        else writeFileSync(path, body, { mode: 0o600 })
+      }
+      return errorOf(error, 'pnpm failed').message.slice(0, 600)
+    }
+  }
+
+  /**
+   * Re-add user plugins after a release seed replaced the project graph (LOCAL PATCH, sbplab).
+   * Bundled plugins come from the seed itself; local package files are copied from the previous
+   * profile; a plugin that cannot be restored is recorded instead of blocking application startup.
+   */
+  private async restorePlugins(
+    projectDir: string,
+    previousProfile: string,
+    previous: readonly (DesktopPluginRecord & { readonly source: DesktopPluginSource; readonly spec: string | undefined })[],
+  ): Promise<readonly DesktopRestoreFailure[]> {
+    const state = this.readPluginState()
+    const seedBundled = new Set(readBundledPlugins(projectDir).map(plugin => plugin.name))
+    const failures: DesktopRestoreFailure[] = []
+    const restored = new Set<string>()
+    const registry = previous.filter(plugin => plugin.source === 'registry' && !seedBundled.has(plugin.name))
+    if (registry.length > 0) {
+      const batch = await this.tryPnpm(projectDir, [
+        'add',
+        ...registry.map(plugin => `${plugin.name}@${plugin.version}`),
+        '--save-exact',
+        '--offline',
+      ])
+      if (batch === undefined) {
+        for (const plugin of registry) restored.add(plugin.name)
+      } else {
+        for (const plugin of registry) {
+          const error = await this.tryPnpm(projectDir, ['add', `${plugin.name}@${plugin.version}`, '--save-exact', '--offline'])
+          if (error === undefined) restored.add(plugin.name)
+          else failures.push({ name: plugin.name, version: plugin.version, source: 'registry', message: error })
+        }
+      }
+    }
+    for (const plugin of previous.filter(row => row.source === 'local')) {
+      const file = localFileOfSpec(plugin.spec)
+      const from = file === undefined ? undefined : join(previousProfile, DESKTOP_LOCAL_PACKAGES_DIR, file)
+      if (file === undefined || from === undefined || !existsSync(from)) {
+        failures.push({ name: plugin.name, version: plugin.version, source: 'local', message: 'the stored package file is missing' })
+        continue
+      }
+      mkdirSync(join(projectDir, DESKTOP_LOCAL_PACKAGES_DIR), { recursive: true, mode: 0o700 })
+      const target = join(projectDir, DESKTOP_LOCAL_PACKAGES_DIR, file)
+      if (!existsSync(target)) copyFileSync(from, target)
+      const spec = localPackageSpec(file)
+      let error = await this.tryPnpm(projectDir, ['add', spec, '--save-exact', '--offline', '--trust-lockfile'])
+      if (error !== undefined) error = await this.tryPnpm(projectDir, ['add', spec, '--save-exact', '--trust-lockfile'])
+      if (error === undefined) {
+        restored.add(plugin.name)
+      } else {
+        failures.push({ name: plugin.name, version: plugin.version, source: 'local', message: error })
+        if (!readBundledPlugins(projectDir).some(row => row.file === file)) rmSync(target, { force: true })
+      }
+    }
+    if (failures.length > 0) {
+      await this.runPnpm(projectDir, ['install', '--offline', '--frozen-lockfile', '--trust-lockfile'])
     }
+    const names = new Set([
+      ...profilePluginNames(projectDir).filter(name => !state.disabledBundled.includes(name)),
+      ...restored,
+    ])
+    writeProfilePlugins(projectDir, [...names].map(name => inspectPlugin(projectDir, name)).sort(byName))
+    return failures
   }
 
