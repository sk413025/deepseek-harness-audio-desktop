+// LOCAL PATCH (sbplab): bundled and local-file plugin lifecycle for the desktop project manager.
+import { spawnSync } from 'node:child_process'
+import { createHash } from 'node:crypto'
+import { existsSync, mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync, statSync, writeFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join, relative, sep } from 'node:path'
+import { afterEach, describe, expect, it } from 'vitest'
+import { resolveDesktopPaths } from '../src/paths.ts'
+import {
+  createSeedMetadata,
+  DESKTOP_BUNDLED_PLUGINS_FILE,
+  DESKTOP_LOCAL_PACKAGES_DIR,
+  DesktopProjectManager,
+  inspectLocalPackage,
+  localPackageFileName,
+  type DesktopProjectHooks,
+} from '../src/project-manager.ts'
+import { DESKTOP_HOST_PROTOCOL_VERSION } from '../src/host-protocol.ts'
+import { DESKTOP_PACKAGES_DIR, DESKTOP_PACKAGE_SET_FILE } from '../src/core-package-set.ts'
+import type { DesktopRelease } from '../src/release.ts'
+import { archivePnpmStore } from '../src/seed-store.ts'
+
+const roots: string[] = []
+
+function temporaryRoot(): string {
+  const root = mkdtempSync(join(tmpdir(), 'dsh desktop local 測試-'))
+  roots.push(root)
+  return root
+}
+
+afterEach(() => {
+  for (const root of roots.splice(0)) rmSync(root, { recursive: true, force: true })
+  delete process.env.TEST_PNPM_LOG
+  delete process.env.TEST_PNPM_FAIL
+})
+
+function release(version = '1.0.0'): DesktopRelease {
+  return { schemaVersion: 1, version, hostProtocolVersion: DESKTOP_HOST_PROTOCOL_VERSION, nodeVersion: '24.17.0', pnpmVersion: '11.7.0' }
+}
+
+function hooks(): DesktopProjectHooks {
+  return { healthCheck: async () => {}, beforeActivate: async () => {}, afterActivate: async () => {} }
+}
+
+function sha256(path: string): string {
+  return createHash('sha256').update(readFileSync(path)).digest('hex')
+}
+
+/** Build a real npm-style tarball: package/package.json plus a bundle patch file. */
+function pluginTarball(root: string, name: string, version: string, options: { plugin?: boolean; marker?: string } = {}): string {
+  const source = mkdtempSync(join(root, 'tarball-src-'))
+  mkdirSync(join(source, 'package'), { recursive: true })
+  writeFileSync(join(source, 'package', 'package.json'), JSON.stringify({
+    name,
+    version,
+    marker: options.marker ?? '',
+    ...(options.plugin === false ? {} : { dsh: { bundle: { patch: './cordis.patch.yml' } } }),
+  }))
+  writeFileSync(join(source, 'package', 'cordis.patch.yml'), '[]\n')
+  const out = join(root, `${name.replace('/', '-').replace('@', '')}-${version}-${options.marker ?? 'a'}.tgz`)
+  const result = spawnSync('tar', ['-czf', out, '-C', source, 'package'])
+  if (result.status !== 0) throw new Error(String(result.stderr))
+  return out
+}
+
+function writeFakePnpm(root: string): string {
+  const path = join(root, 'pnpm.mjs')
+  writeFileSync(path, String.raw`
+import { spawnSync } from 'node:child_process'
+import { appendFileSync, cpSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs'
+import { join } from 'node:path'
+const args = process.argv.slice(2)
+const project = process.cwd()
+const command = args.find(value => value === 'install' || value === 'add' || value === 'remove')
+if (process.env.TEST_PNPM_LOG) appendFileSync(process.env.TEST_PNPM_LOG, JSON.stringify({ args }) + '\n')
+if (process.env.TEST_PNPM_FAIL && command === 'add' && args.some(value => value.includes(process.env.TEST_PNPM_FAIL))) {
+  process.stderr.write('simulated offline metadata failure')
+  process.exit(1)
+}
+const manifestPath = join(project, 'package.json')
+const manifest = JSON.parse(readFileSync(manifestPath, 'utf8'))
+const tarballManifest = file => JSON.parse(spawnSync('tar', ['-xzOf', file, 'package/package.json'], { encoding: 'utf8' }).stdout)
+const registryName = spec => spec.startsWith('@') ? spec.slice(0, spec.indexOf('@', 1)) : spec.split('@')[0]
+if (command === 'add') {
+  for (const spec of args.slice(args.indexOf('add') + 1).filter(value => !value.startsWith('-'))) {
+    if (spec.startsWith('file:')) manifest.dependencies[tarballManifest(join(project, spec.slice(5))).name] = spec
+    else manifest.dependencies[registryName(spec)] = spec.slice(registryName(spec).length + 1)
+  }
+}
+if (command === 'remove') delete manifest.dependencies[args[args.indexOf('remove') + 1]]
+writeFileSync(manifestPath, JSON.stringify(manifest))
+rmSync(join(project, 'node_modules'), { recursive: true, force: true })
+const release = JSON.parse(readFileSync(join(project, 'desktop-release.json'), 'utf8')).version
+for (const [name, spec] of Object.entries(manifest.dependencies)) {
+  const packageRoot = join(project, 'node_modules', ...name.split('/'))
+  if (spec.startsWith('file:./desktop-local-packages/')) {
+    const temporary = mkdtempSync(join(project, '.extract-'))
+    spawnSync('tar', ['-xzf', join(project, spec.slice(5)), '-C', temporary])
+    mkdirSync(join(packageRoot, '..'), { recursive: true })
+    cpSync(join(temporary, 'package'), packageRoot, { recursive: true })
+    rmSync(temporary, { recursive: true, force: true })
+    continue
+  }
+  mkdirSync(packageRoot, { recursive: true })
+  const core = spec.startsWith('file:./desktop-packages/')
+  writeFileSync(join(packageRoot, 'package.json'), JSON.stringify({
+    name, version: core ? release : spec, ...(core ? {} : { dsh: { bundle: { patch: './bundle.yml' } } }),
+  }))
+  if (!core) writeFileSync(join(packageRoot, 'bundle.yml'), '[]\n')
+  if (name === '@deepseek-ai/dsh-desktop-host') {
+    mkdirSync(join(packageRoot, 'lib'), { recursive: true })
+    writeFileSync(join(packageRoot, 'lib', 'index.js'), '')
+  }
+}
+writeFileSync(join(project, 'pnpm-lock.yaml'), 'lockfileVersion: 9\n' + JSON.stringify(manifest.dependencies) + '\n')
+`)
+  return path
+}
+
+function writeCorePackageSet(seed: string, version: string): void {
+  const packages = [
+    { name: '@deepseek-ai/dsh', file: `deepseek-ai-dsh-${version}.tgz`, body: Buffer.from(`dsh-${version}`) },
+    { name: '@deepseek-ai/dsh-desktop-host', file: `deepseek-ai-dsh-desktop-host-${version}.tgz`, body: Buffer.from(`host-${version}`) },
+  ]
+  mkdirSync(join(seed, DESKTOP_PACKAGES_DIR), { recursive: true })
+  for (const entry of packages) writeFileSync(join(seed, DESKTOP_PACKAGES_DIR, entry.file), entry.body)
+  writeFileSync(join(seed, DESKTOP_PACKAGE_SET_FILE), `${JSON.stringify({
+    schemaVersion: 1,
+    packages: packages.map(({ name, file, body }) => ({
+      name, version, file, bytes: body.byteLength, integrity: `sha512-${createHash('sha512').update(body).digest('base64')}`,
+    })),
+  })}\n`)
+}
+
+function writeIntegrity(seed: string): void {
+  const paths: string[] = []
+  const visit = (directory: string): void => {
+    for (const entry of readdirSync(directory, { withFileTypes: true })) {
+      const path = join(directory, entry.name)
+      if (entry.isDirectory()) visit(path)
+      else if (entry.name !== 'integrity.json') paths.push(path)
+    }
+  }
+  visit(seed)
+  const files = paths.sort().map(path => ({
+    path: relative(seed, path).split(sep).join('/'), bytes: statSync(path).size, sha256: sha256(path),
+  }))
+  writeFileSync(join(seed, 'integrity.json'), `${JSON.stringify({ schemaVersion: 2, files })}\n`)
+}
+
+/** A release seed that bundles the given plugin tarballs the way prepare-seed does. */
+function seedWithBundled(root: string, label: string, version: string, bundled: readonly string[]): string {
+  const seed = join(root, label)
+  writeCorePackageSet(seed, version)
+  createSeedMetadata(seed, release(version))
+  const manifest = JSON.parse(readFileSync(join(seed, 'package.json'), 'utf8')) as {
+    dependencies: Record<string, string>; dsh: { profile: { bundles: string[] } }
+  }
+  const rows = bundled.map((tarball) => {
+    const identity = inspectLocalPackage(tarball)
+    const file = localPackageFileName(identity.name, identity.version, identity.sha256)
+    mkdirSync(join(seed, DESKTOP_LOCAL_PACKAGES_DIR), { recursive: true })
+    writeFileSync(join(seed, DESKTOP_LOCAL_PACKAGES_DIR, file), readFileSync(tarball))
+    manifest.dependencies[identity.name] = `file:./${DESKTOP_LOCAL_PACKAGES_DIR}/${file}`
+    manifest.dsh.profile.bundles.push(identity.name)
+    return { name: identity.name, version: identity.version, file, sha256: identity.sha256 }
+  })
+  writeFileSync(join(seed, 'package.json'), `${JSON.stringify(manifest, undefined, 2)}\n`)
+  if (rows.length > 0) writeFileSync(join(seed, DESKTOP_BUNDLED_PLUGINS_FILE), `${JSON.stringify({ schemaVersion: 1, plugins: rows }, undefined, 2)}\n`)
+  writeFileSync(join(seed, 'pnpm-lock.yaml'), 'lockfileVersion: 9\n')
+  mkdirSync(join(seed, 'store'), { recursive: true })
+  writeFileSync(join(seed, 'store', `entry-${label}`), label)
+  archivePnpmStore(seed, join(seed, 'store'))
+  writeIntegrity(seed)
+  return seed
+}
+
+function bundles(profile: string): string[] {
+  return (JSON.parse(readFileSync(join(profile, 'package.json'), 'utf8')) as { dsh: { profile: { bundles: string[] } } }).dsh.profile.bundles
+}
+
+function pnpmCalls(log: string): string[][] {
+  return existsSync(log) ? readFileSync(log, 'utf8').trim().split('\n').map(line => (JSON.parse(line) as { args: string[] }).args) : []
+}
+
+describe('local plugin package inspection', () => {
+  it('accepts a Harness plugin tarball and rejects other files', () => {
