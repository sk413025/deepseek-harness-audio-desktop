+    expect(() => inspectLocalPackage(pluginTarball(root, 'not-a-plugin', '1.0.0', { plugin: false }))).toThrow(/not a Harness plugin/u)
+    writeFileSync(join(root, 'garbage.tgz'), 'not gzip')
+    expect(() => inspectLocalPackage(join(root, 'garbage.tgz'))).toThrow(/not an npm package tarball/u)
+    expect(() => inspectLocalPackage('relative.tgz')).toThrow(/choose a plugin package file/u)
+    expect(localPackageFileName('@lab/voice', '0.1.0', 'a'.repeat(64))).toBe('lab-voice-0.1.0-aaaaaaaaaaaa.tgz')
