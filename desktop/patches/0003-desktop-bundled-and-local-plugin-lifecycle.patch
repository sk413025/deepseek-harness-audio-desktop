+// LOCAL PATCH (sbplab): media permission policy.
+import { describe, expect, it } from 'vitest'
+import { decidePermissionCheck, decidePermissionRequest } from '../src/permissions.ts'
+
+describe('desktop media permission policy', () => {
+  it('allows audio capture only for the app origin main frame', () => {
+    expect(decidePermissionRequest({ permission: 'media', mediaTypes: ['audio'], requestingUrl: 'dsh-app://app/index.html', isMainFrame: true })).toBe(true)
+    expect(decidePermissionRequest({ permission: 'media', mediaTypes: ['audio', 'video'], requestingUrl: 'dsh-app://app/index.html' })).toBe(false)
+    expect(decidePermissionRequest({ permission: 'media', mediaTypes: ['video'], requestingUrl: 'dsh-app://app/index.html' })).toBe(false)
+    expect(decidePermissionRequest({ permission: 'media', mediaTypes: ['audio'], requestingUrl: 'https://example.test/' })).toBe(false)
+    expect(decidePermissionRequest({ permission: 'media', mediaTypes: ['audio'], requestingUrl: 'dsh-app://shell/plugin-manager.html' })).toBe(false)
+    expect(decidePermissionRequest({ permission: 'media', mediaTypes: ['audio'], requestingUrl: 'dsh-app://app/x', isMainFrame: false })).toBe(false)
+    expect(decidePermissionRequest({ permission: 'media', mediaTypes: [], requestingUrl: 'dsh-app://app/x' })).toBe(false)
+  })
+
+  it('keeps other permissions on the default decision', () => {
+    expect(decidePermissionRequest({ permission: 'clipboard-sanitized-write', requestingUrl: 'dsh-app://app/' })).toBe(true)
+    expect(decidePermissionCheck('fullscreen', 'dsh-app://app')).toBe(true)
+    expect(decidePermissionCheck('media', 'dsh-app://app', 'audio')).toBe(true)
+    expect(decidePermissionCheck('media', 'dsh-app://app', 'video')).toBe(false)
+    expect(decidePermissionCheck('media', 'https://example.test', 'audio')).toBe(false)
+  })
+})
