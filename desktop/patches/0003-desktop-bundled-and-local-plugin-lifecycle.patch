+/**
+ * LOCAL PATCH (sbplab): media permission policy for the Desktop shell.
+ *
+ * Electron grants every permission request by default. Audio capture for the shared voice UI is allowed only for the
+ * app's own `dsh-app://app` origin and only for audio (no camera/screen). All other permission kinds keep Electron's
+ * default decision. macOS still shows its own microphone prompt on first use.
+ */
+
+/** The request details this policy reads. */
+export interface MediaPermissionRequest {
+  readonly permission: string
+  readonly requestingUrl?: string | undefined
+  readonly mediaTypes?: readonly string[] | undefined
+  readonly isMainFrame?: boolean | undefined
+}
+
+const APP_ORIGIN = 'dsh-app://app'
+
+function fromAppOrigin(url: string | undefined): boolean {
+  if (url === undefined) return false
+  try {
+    const parsed = new URL(url)
+    return `${parsed.protocol}//${parsed.host}` === APP_ORIGIN
+  } catch {
+    // An unparsable requesting URL cannot be the app origin.
+    return false
+  }
+}
+
+/**
+ * Decide a permission request.
+ * @param request - Electron's permission name plus request details.
+ * @returns true to grant, false to deny.
+ */
+export function decidePermissionRequest(request: MediaPermissionRequest): boolean {
+  if (request.permission !== 'media') return true
+  const types = request.mediaTypes ?? []
+  const audioOnly = types.length > 0 && types.every(type => type === 'audio')
+  return audioOnly && request.isMainFrame !== false && fromAppOrigin(request.requestingUrl)
+}
+
+/**
+ * Decide a synchronous permission check (e.g. `navigator.permissions`, device enumeration labels).
+ * @param permission - Electron's permission name.
+ * @param requestingOrigin - origin performing the check.
+ * @param mediaType - media type for `media` checks.
+ * @returns true when allowed.
+ */
+export function decidePermissionCheck(permission: string, requestingOrigin: string, mediaType?: string): boolean {
+  if (permission !== 'media') return true
+  return (mediaType === undefined || mediaType === 'audio' || mediaType === 'unknown') && fromAppOrigin(requestingOrigin)
+}
