+function addBundledPlugins(): void {
+  const directory = process.env.DSH_DESKTOP_BUNDLED_PLUGINS_DIR
+  if (directory === undefined || directory === '') return
+  const tarballs = readdirSync(directory).filter(name => name.endsWith('.tgz')).sort()
+  if (tarballs.length === 0) throw new Error(`desktop seed: no plugin packages in ${directory}`)
+  const manifestPath = join(SEED_ROOT, 'package.json')
