{
  "name": "dsh-voice-capture",
  "version": "0.3.8",
  "description": "DeepSeek Harness client plugin: shared audio UI for Web and Desktop — explicit microphone record/preview/send as a raw WAV attachment, inline and progressive reply playback, and capability-labelled Live mode over the audio adapter routes",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-file-upload",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node scripts/test.mjs",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
